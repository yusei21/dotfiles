#!/usr/bin/env bash
set -euo pipefail
case "${1:-region}" in
region) geometry=$(slurp) || exit 0; grim -g "$geometry" - | wl-copy --type image/png;;
monitor) output=$(hyprctl -j monitors | jq -er '.[] | select(.focused) | .name'); grim -o "$output" - | wl-copy --type image/png;;
*) exit 2;;
esac
notify-send "Screenshot copied"
