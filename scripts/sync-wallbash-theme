#!/usr/bin/env bash
set -Eeuo pipefail

COLORS="${HYDE_CACHE_HOME:-$HOME/.cache/hyde}/wallbash/shell-colors"
KITTY_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/theme.conf"

if [[ ! -s "$COLORS" ]]; then
  printf 'Paleta Wallbash não encontrada: %s\n' "$COLORS" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$COLORS"

required=(
  wallbash_pry1 wallbash_pry2 wallbash_pry3 wallbash_pry4
  wallbash_txt1 wallbash_txt4
  wallbash_1xa2 wallbash_1xa3 wallbash_1xa6 wallbash_1xa8 wallbash_1xa9
  wallbash_2xa3 wallbash_2xa4 wallbash_2xa6 wallbash_2xa9
  wallbash_3xa6 wallbash_3xa7 wallbash_3xa8 wallbash_3xa9
  wallbash_4xa5 wallbash_4xa6 wallbash_4xa7 wallbash_4xa8 wallbash_4xa9
)

for name in "${required[@]}"; do
  if [[ -z "${!name:-}" ]]; then
    printf 'Cor obrigatória ausente em %s: %s\n' "$COLORS" "$name" >&2
    exit 1
  fi
done

mkdir -p "$(dirname "$KITTY_THEME")"

cat > "$KITTY_THEME" <<THEME
## Wallbash dynamic theme
## Generated automatically from $COLORS

foreground              ${wallbash_txt1}
background              ${wallbash_pry1}
selection_foreground    ${wallbash_txt1}
selection_background    ${wallbash_2xa3}
cursor                  ${wallbash_pry4}
cursor_text_color       ${wallbash_txt4}
url_color               ${wallbash_4xa7}
active_border_color     ${wallbash_pry4}
inactive_border_color   ${wallbash_1xa2}
bell_border_color       ${wallbash_3xa8}
wayland_titlebar_color  ${wallbash_pry1}
macos_titlebar_color    ${wallbash_pry1}
active_tab_foreground   ${wallbash_txt4}
active_tab_background   ${wallbash_pry4}
inactive_tab_foreground ${wallbash_txt1}
inactive_tab_background ${wallbash_pry2}
tab_bar_background      ${wallbash_pry1}
mark1_foreground        ${wallbash_txt4}
mark1_background        ${wallbash_pry4}
mark2_foreground        ${wallbash_txt1}
mark2_background        ${wallbash_pry3}
mark3_foreground        ${wallbash_txt1}
mark3_background        ${wallbash_2xa4}
color0                  ${wallbash_pry1}
color8                  ${wallbash_1xa3}
color1                  ${wallbash_3xa7}
color9                  ${wallbash_3xa9}
color2                  ${wallbash_4xa6}
color10                 ${wallbash_4xa9}
color3                  ${wallbash_3xa6}
color11                 ${wallbash_3xa8}
color4                  ${wallbash_1xa6}
color12                 ${wallbash_1xa9}
color5                  ${wallbash_2xa6}
color13                 ${wallbash_2xa9}
color6                  ${wallbash_4xa5}
color14                 ${wallbash_4xa8}
color7                  ${wallbash_1xa8}
color15                 ${wallbash_txt1}
THEME

pkill -SIGUSR1 kitty 2>/dev/null || true

if command -v hyde-shell >/dev/null 2>&1; then
  hyde-shell wallbash code 2>/dev/null || true
  hyde-shell wallbash spotify 2>/dev/null || true
fi

printf 'Tema Wallbash sincronizado: Kitty, Antigravity IDE e Spotify.\n'
