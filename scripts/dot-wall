#!/usr/bin/env bash
set -euo pipefail
role=${1:?horizontal or vertical}
action=${2:-next}
case "$role" in horizontal) monitor=DP-3;; vertical) monitor=HDMI-A-1;; *) exit 2;; esac
dir="$HOME/Pictures/Wallpapers/$role"
state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
mkdir -p "$dir" "$state"
exec 9>"$state/$role.lock"
flock 9
current=""
[[ ! -f "$state/$role" ]] || current=$(cat "$state/$role")
mapfile -d '' -t images < <(find "$dir" -maxdepth 1 -type f ! -name '*,*' \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z)
if(( ${#images[@]} == 0 )); then exit 0; fi
case "$action" in
 restore) image="$current"; [[ -f "$image" ]] || image="${images[0]}";;
 next) image="${images[0]}"; for i in "${!images[@]}"; do if [[ "${images[i]}" == "$current" ]]; then image="${images[(i+1)%${#images[@]}]}"; break; fi; done;;
 select) image=$(printf '%s\n' "${images[@]}" | fuzzel --dmenu) || exit 0;;
 *) exit 2;;
esac
[[ -f "$image" && "$image" == "$dir/"* && "$image" != *,* ]] || exit 2
# Hyprpaper 0.8.5 may return no text on success.
# At login, outputs and the Hyprpaper IPC socket may not be ready yet.
attempts=1
[[ "$action" != restore ]] || attempts=30
for ((attempt=1; attempt<=attempts; attempt++)); do
    if hyprctl hyprpaper wallpaper "$monitor,$image,cover"; then
        break
    fi
    if (( attempt == attempts )); then
        notify-send "Wallpaper change failed" "$monitor" || true
        exit 1
    fi
    sleep 1
done
printf '%s\n' "$image" > "$state/$role"
