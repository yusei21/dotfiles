#!/usr/bin/env bash
set -euo pipefail
image=${1:?wallpaper path required}
cfg="$HOME/.config"
paths=(waybar/colors.css hypr/colors.lua nvim/colors-generated.lua fuzzel/colors.ini mako/config cava/config hypr/hyprlock.conf qt6ct/colors/matugen.conf gtk-3.0/gtk.css gtk-4.0/gtk.css kdeglobals)
mkdir -p "$cfg/qt6ct/colors" "$cfg/gtk-3.0" "$cfg/gtk-4.0"
backup=$(mktemp -d)
trap 'rm -rf -- "$backup"' EXIT
for path in "${paths[@]}"; do
  if [[ -f "$cfg/$path" ]]; then mkdir -p "$backup/$(dirname "$path")"; cp -- "$cfg/$path" "$backup/$path"; fi
done
if ! matugen image "$image" -m dark --source-color-index 0 </dev/null; then
  for path in "${paths[@]}"; do
    if [[ -f "$backup/$path" ]]; then cp -- "$backup/$path" "$cfg/$path"; else rm -f -- "$cfg/$path"; fi
  done
  notify-send "Theme generation failed; previous palette restored" || true
  exit 1
fi
pkill -USR2 -x waybar || true
makoctl reload || true
hyprctl eval 'dofile(os.getenv("HOME") .. "/.config/hypr/colors.lua")' || true
