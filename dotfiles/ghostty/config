font-family = JetBrainsMono Nerd Font
font-size = 12
background = #111317
foreground = #e5e8ec
background-opacity = 0.88
window-padding-x = 14
window-padding-y = 12
cursor-style = block
keybind = ctrl+shift+a=select_all
keybind = chain=copy_to_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = shift+escape=text:~
