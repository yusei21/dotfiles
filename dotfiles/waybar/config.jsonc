{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["cpu", "memory", "temperature", "pulseaudio", "network", "clock", "tray"],
  "hyprland/workspaces": { "disable-scroll": true, "all-outputs": false },
  "cpu": { "format": "CPU {usage}%", "interval": 2 },
  "memory": { "format": "RAM {percentage}%", "interval": 2 },
  "temperature": { "format": "TEMP {temperatureC}°C", "interval": 2, "critical-threshold": 85 },
  "clock": { "format": "{:%H:%M}" },
  "pulseaudio": { "format": "VOL {volume}%", "format-muted": "MUTE" },
  "network": { "format-wifi": "NET", "format-ethernet": "LAN", "format-disconnected": "OFF" },
  "tray": { "spacing": 6 }
}
