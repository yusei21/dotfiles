configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    font: "Ndot55Caps Bold 12";

    bg:            rgba(0,0,0,0.92);
    bg-alt:        rgba(10,10,10,0.96);
    fg:            rgba(255,255,255,1);
    fg-alt:        rgba(220,220,220,1);
    border-col:    rgba(255,255,255,0.08);
    selected:      rgba(35,35,35,1);
    selected-fg:   rgba(255,255,255,1);
}

window {
    location: center;
    anchor: center;
    fullscreen: false;
    width: 620px;

    enabled: true;
    border-radius: 14px;
    background-color: @bg;
    border: 1px;
    border-color: @border-col;
}

mainbox {
    enabled: true;
    spacing: 14px;
    padding: 16px;
    background-color: transparent;
    orientation: vertical;
    children: [ "inputbar", "listview" ];
}

inputbar {
    enabled: true;
    spacing: 10px;
    padding: 12px;
    border-radius: 10px;
    background-color: @bg-alt;
    text-color: @fg;
    children: [ "entry" ];
}

entry {
    enabled: true;
    expand: true;
    background-color: transparent;
    text-color: @fg;
    placeholder: "TYPE TO SEARCH";
    placeholder-color: rgba(180,180,180,0.9);
    cursor: text;
}

listview {
    enabled: true;
    columns: 1;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    spacing: 8px;
    background-color: transparent;
    text-color: @fg;
}

element {
    enabled: true;
    spacing: 12px;
    padding: 12px;
    border-radius: 10px;
    background-color: @bg-alt;
    text-color: @fg;
    cursor: pointer;
}

element normal.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: @selected-fg;
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 24px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

message {
    enabled: false;
}

mode-switcher {
    enabled: false;
}

textbox {
    enabled: false;
}

error-message {
    enabled: false;
}

