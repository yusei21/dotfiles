{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 12,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/system",
    "memory",
    "wireplumber",
    "network",
    "clock"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": false
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5,
    "on-click": "kitty btop"
  },
  "wireplumber": {
    "format": "VOL {volume}%"
  },
  "network": {
    "format-ethernet": "LAN",
    "format-wifi": "WIFI",
    "format-disconnected": "OFF"
  },
  "clock": {
    "format": "{:%H:%M}"
  },
  "custom/system": {
    "exec": "$HOME/.local/bin/dot-stats",
    "return-type": "json",
    "interval": 5,
    "on-click": "kitty btop",
    "on-click-right": "kitty nvtop",
    "tooltip": true
  },
  "margin": "5 10 4 10"
}
